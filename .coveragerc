[run]
source = clear_budget
branch = True

[report]
show_missing = True
skip_covered = False
fail_under = 100

exclude_lines =
    pragma: no cover
    \.\.\.
    if TYPE_CHECKING:
    raise NotImplementedError
    @(abc\.)?abstractmethod
    if __name__ == .__main__.:

omit =
    main.py
    clear_budget/ui/*
    clear_budget/domain/interfaces/*
    # Protocol-only port modules, imported solely under TYPE_CHECKING: there
    # is nothing to execute, on the same grounds as domain/interfaces.
    clear_budget/application/ports/*
    clear_budget/shared/resources.py
    */__pycache__/*
    */venv/*
    buildexe.py
    buildinstaller.py
    # The setup program's Qt client and its composition root, excluded on the
    # same grounds as clear_budget/ui: their correctness lives in a real Qt
    # event loop rather than in branch coverage of pure logic. Everything else
    # under installer/ is Qt-free and is inside the gate.
    installer/app.py
    installer/ui/*
    # A build script (a linear recipe) and the staged payload package.
    installer/build_payload.py
    installer/payload/*
    installer/resources/*
